# Copier ce fichier en `.env` (à la racine, ignoré par git) et remplir.
# Le dépôt est public : `.env` n'y entre jamais. Voir _memory/secrets-et-configuration.md.

# --- Application Meta « Scoutisme Européen Suisse » (issue #22) ---
# L'App ID est public. Le secret se lit dans Meta for Developers → Paramètres → Général.
META_APP_ID=3810353042437212
META_APP_SECRET=

# Obtenus par `node --env-file-if-exists=.env scripts/meta-token.mjs <jeton court>` :
META_PAGE_ID=
META_PAGE_TOKEN=
META_IG_USER_ID=

# Facultatif : version de l'API Graph (par défaut v23.0) et nombre de publications gardées (12).
# META_GRAPH_VERSION=v23.0
# META_IG_KEEP=12

# --- Carte des implantations (issue #20) ---
# Identifiant de la carte Google My Maps du mouvement. Publique, pas un secret.
# SES_MAP_ID=1mLNKImv1_q7I8xmzMt3Nnnb_ulE
