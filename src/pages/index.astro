---
/**
 * La racine du site. Elle ne montre rien : elle envoie le visiteur vers
 * /fr/ ou /de/ selon la langue de son navigateur, en lisant toute sa liste
 * de préférences. Sans JavaScript, le <meta refresh> l'emmène en français.
 *
 * Volontairement `noindex` : c'est un aiguillage, pas un contenu. Elle est
 * aussi exclue du sitemap (voir astro.config.mjs).
 */
import { SITE, withBase } from '../data/site';
export const prerender = true;

// Le sous-dossier de service est injecté dans la page : le script doit
// fonctionner aussi bien à la racine d'un domaine que sous /website/.
const fr = withBase('/fr/');
const de = withBase('/de/');
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <title>{SITE.name}</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(fr, SITE.domain).href} />
    <script is:inline define:vars={{ fr, de }}>
      (function () {
        try {
          var langs =
            navigator.languages && navigator.languages.length
              ? Array.from(navigator.languages)
              : [navigator.language || 'fr'];
          var isDe = langs.some(function (l) {
            return l.toLowerCase().indexOf('de') === 0;
          });
          location.replace(isDe ? de : fr);
        } catch (_) {
          location.replace(fr);
        }
      })();
    </script>
    <meta http-equiv="refresh" content={`0;url=${fr}`} />
  </head>
  <body>
    <a href={fr}>Français</a> · <a href={de}>Deutsch</a>
  </body>
</html>
