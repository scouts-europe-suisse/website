---
/**
 * La liste des actualités. Remplace le /fr/category/actualites/ de WordPress
 * (voir _memory/source-site.md) : une adresse lisible plutôt qu'un artefact
 * de l'outil.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { LANGS, UI, path, type Lang } from '../../../data/site';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };

const articles = (await getCollection('news', (e) => e.id.startsWith(`${lang}/`) && !e.data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title={UI.news[lang]} lang={lang}>
  <h1 style="font-size: var(--text-h1)">{UI.news[lang]}</h1>

  {articles.length === 0 ? (
    <p class="mt-6" style="color: var(--ses-muted)">{UI.noNews[lang]}</p>
  ) : (
    <ul class="mt-8 grid gap-6">
      {articles.map((a) => (
        <li class="border-b pb-6" style="border-color: var(--ses-border)">
          <p style="color: var(--ses-muted); font-size: var(--text-small)">
            <time datetime={a.data.date.toISOString()}>
              {a.data.date.toLocaleDateString(lang === 'fr' ? 'fr-CH' : 'de-CH', {
                day: 'numeric',
                month: 'long',
                year: 'numeric',
              })}
            </time>
          </p>
          <h2 class="mt-1" style="font-size: var(--text-h3)">
            <a href={`${path(lang, 'actualites')}${a.id.split('/')[1]}/`}>{a.data.title}</a>
          </h2>
          {a.data.summary && <p class="mt-2 ses-prose">{a.data.summary}</p>}
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
