---
/**
 * La route unique du site : pages de contenu, liste des actualités, et
 * chaque actualité.
 *
 * Pourquoi une seule route pour trois choses : Astro n'autorise qu'un seul
 * fichier « attrape-tout » par niveau, et les adresses diffèrent d'une langue
 * à l'autre (/fr/actualites/ mais /de/aktuelles/). Générer les trois ici est
 * la façon la plus simple de garder des adresses en bon allemand.
 *
 * `kind` dit laquelle des trois est rendue. Chaque cas reste court.
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageNotices from '../../components/PageNotices.astro';
import ContactForm from '../../components/ContactForm.astro';
import ImplantationsMap from '../../components/ImplantationsMap.astro';
import NewsList from '../../components/NewsList.astro';
import NewsArticle from '../../components/NewsArticle.astro';
import SectionIndex from '../../components/SectionIndex.astro';
import { childrenOf } from '../../lib/pages';
import { withBase } from '../../data/site';
import { imageSize, isEmblem } from '../../lib/imageSize';
import Search from '../../components/Search.astro';
import { LANGS, NEWS_BASE, SEARCH_BASE, UI, type Lang } from '../../data/site';

export async function getStaticPaths() {
  const out: any[] = [];

  const pages = await getCollection('pages');
  for (const entry of pages) {
    if (entry.data.key === 'home') continue;
    out.push({
      params: { lang: entry.id.split('/')[0], slug: entry.data.urlPath },
      props: { kind: 'page', entry },
    });
  }

  for (const lang of LANGS) {
    out.push({ params: { lang, slug: NEWS_BASE[lang] }, props: { kind: 'news-index' } });
    out.push({ params: { lang, slug: SEARCH_BASE[lang] }, props: { kind: 'search' } });
  }

  const news = await getCollection('news');
  for (const entry of news) {
    const [lang, slug] = entry.id.split('/') as [Lang, string];
    out.push({
      params: { lang, slug: `${NEWS_BASE[lang]}/${slug}` },
      props: { kind: 'news', entry },
    });
  }

  return out;
}

const { kind, entry } = Astro.props as { kind: string; entry?: any };
const { lang } = Astro.params as { lang: Lang };

const rendered = kind === 'page' || kind === 'news' ? await render(entry) : null;
const Content = rendered?.Content;

// Une page de rubrique sans texte propre affiche le sommaire de ses filles
// plutôt qu'une page blanche.
// `body` peut être absent selon le chargeur : on ne suppose pas qu'il existe.
const emptyBody =
  kind === 'page' &&
  !entry.data.contactForm &&
  (entry.body ?? '').replace(/<!--[\s\S]*?-->/g, '').trim() === '';

// Une rubrique qui affiche le sommaire de ses filles n'est pas une page
// blanche : elle rend service telle quelle. Le bandeau « ébauche » ne
// s'affiche donc que si elle n'a vraiment rien à montrer.
// Dimensions réelles de l'image à la une : elles évitent que la page saute
// au chargement, et disent si c'est un écusson ou un bandeau.
const coverSize = entry?.data?.cover ? imageSize(entry.data.cover) : null;
const coverEmblem = isEmblem(coverSize);

const sectionChildren =
  emptyBody ? await childrenOf(entry.data.key, lang) : [];
const showsIndex = sectionChildren.length > 0;

const accent =
  kind === 'page' && entry.data.branche
    ? `var(--ses-branche-${entry.data.branche})`
    : 'var(--ses-primary)';
---

{kind === 'search' && (
  <BaseLayout title={UI.search[lang]} lang={lang} noindex>
    <h1 style="font-size: var(--text-h1)">{UI.search[lang]}</h1>
    <p class="mt-2" style="color: var(--ses-muted)">{UI.searchIntro[lang]}</p>
    <div class="mt-6"><Search lang={lang} /></div>
  </BaseLayout>
)}

{kind === 'news-index' && (
  <BaseLayout title={UI.news[lang]} lang={lang} pageKey="news-index">
    <NewsList lang={lang} />
  </BaseLayout>
)}

{kind === 'news' && (
  <BaseLayout
    title={entry.data.title}
    description={entry.data.summary}
    lang={lang}
    ogType="article"
    noindex={entry.data.draft}
  >
    <NewsArticle entry={entry} lang={lang}>
      <Content />
    </NewsArticle>
  </BaseLayout>
)}

{kind === 'page' && (
  <BaseLayout
    title={entry.data.title}
    description={entry.data.description}
    lang={lang}
    pageKey={entry.data.key}
    noindex={entry.data.draft}
  >
    <article>
      {/* L'image à la une, au-dessus du titre, comme sur le site actuel. */}
      {entry.data.cover && (
        <img
          src={withBase(entry.data.cover)}
          alt={entry.data.coverAlt ?? ''}
          class:list={['ses-cover', coverEmblem && 'ses-cover--ecusson']}
          width={coverSize?.w}
          height={coverSize?.h}
          loading="eager"
        />
      )}

      {/* Une page de branche garde un filet de sa couleur : c'est le seul
          repère visuel qui distingue les trois branches. Les autres pages
          n'en ont pas, comme sur le site actuel. */}
      {entry.data.branche && (
        <div style={`width: 3rem; height: 4px; background: ${accent}`}></div>
      )}
      <h1 class={entry.data.branche ? 'mt-4' : ''} style="font-size: var(--text-h1)">
        {entry.data.title}
      </h1>
      <div class="mt-6">
        <PageNotices
          lang={lang}
          draft={entry.data.draft && !showsIndex}
          translated={entry.data.translated}
        />
        <div class="ses-prose">
          <Content />
        </div>
        {showsIndex && <SectionIndex lang={lang} children={sectionChildren} />}
        {entry.data.map && <ImplantationsMap lang={lang} />}
        {entry.data.contactForm && <ContactForm lang={lang} />}
      </div>
    </article>
  </BaseLayout>
)}
