---
/**
 * Toutes les pages de contenu : une page markdown de src/content/pages/
 * devient automatiquement une page du site, à l'adresse de son slug.
 *
 * Ajouter une page = ajouter un fichier .md, dans les deux langues.
 * Rien à déclarer ici.
 *
 * Les slugs à plusieurs niveaux (notre-scoutisme/qui-sommes-nous) sont gérés
 * par le [...slug], qui accepte les barres obliques.
 */
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageNotices from '../../components/PageNotices.astro';
import type { Lang } from '../../data/site';

export async function getStaticPaths() {
  // Les slugs qui ont déjà leur propre fichier .astro dans ce dossier sont
  // rendus là-bas ; les exclure ici évite un conflit de routes.
  const routesDediees = Object.keys(import.meta.glob('./*.astro'))
    .map((p) => p.replace('./', '').replace('.astro', ''))
    .filter((n) => !n.startsWith('['));

  const entries = await getCollection('pages');
  return entries
    .filter((entry) => {
      const slug = entry.id.split('/').slice(1).join('/');
      return slug && slug !== 'home' && !routesDediees.includes(slug.split('/')[0]);
    })
    .map((entry) => {
      const [lang, ...rest] = entry.id.split('/');
      return { params: { lang, slug: rest.join('/') } };
    });
}

const { lang, slug } = Astro.params as { lang: Lang; slug: string };
const entry = await getEntry('pages', `${lang}/${slug}`);
if (!entry) throw new Error(`Contenu manquant pour ${lang}/${slug}`);
const { Content } = await render(entry);

// Une page de branche prend la couleur de sa branche en filet de titre.
const accent = entry.data.branche ? `var(--ses-branche-${entry.data.branche})` : 'var(--ses-primary)';
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  lang={lang}
  noindex={entry.data.draft}
>
  <article>
    <div style={`width: 3rem; height: 4px; background: ${accent}`}></div>
    <h1 class="mt-4" style="font-size: var(--text-h1)">{entry.data.title}</h1>

    <div class="mt-6">
      <PageNotices lang={lang} draft={entry.data.draft} translated={entry.data.translated} />
      <div class="ses-prose">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
