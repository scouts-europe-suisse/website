---
/**
 * La route unique du site : pages de contenu, liste des actualités, chaque
 * actualité, et la recherche.
 *
 * Pourquoi une seule route pour tout : Astro n'autorise qu'un seul fichier
 * « attrape-tout » par niveau, et les adresses diffèrent d'une langue à
 * l'autre (/fr/actualites/ mais /de/aktuelles/). Générer tout ici est la
 * façon la plus simple de garder des adresses en bon allemand.
 *
 * `kind` dit ce qui est rendu.
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageNotices from '../../components/PageNotices.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import SwissMap from '../../components/SwissMap.astro';
import ImplantationsExplorer from '../../components/ImplantationsExplorer.astro';
import NewsList from '../../components/NewsList.astro';
import NewsArticle from '../../components/NewsArticle.astro';
import SectionIndex from '../../components/SectionIndex.astro';
import BrancheIcon from '../../components/BrancheIcon.astro';
import Search from '../../components/Search.astro';
import { BRANCHES } from '../../data/pictos';
import { childrenOf, pathFor } from '../../lib/pages';
import { imageSize, isEmblem } from '../../lib/imageSize';
import { LANGS, NAV, NEWS_BASE, SEARCH_BASE, UI, withBase, path, type Lang } from '../../data/site';

export async function getStaticPaths() {
  const out: any[] = [];

  const pages = await getCollection('pages');
  for (const entry of pages) {
    if (entry.data.key === 'home') continue;
    out.push({
      params: { lang: entry.id.split('/')[0], slug: entry.data.urlPath },
      props: { kind: 'page', entry },
    });
  }

  for (const lang of LANGS) {
    out.push({ params: { lang, slug: NEWS_BASE[lang] }, props: { kind: 'news-index' } });
    out.push({ params: { lang, slug: SEARCH_BASE[lang] }, props: { kind: 'search' } });
  }

  const news = await getCollection('news');
  for (const entry of news) {
    const [lang, slug] = entry.id.split('/') as [Lang, string];
    out.push({
      params: { lang, slug: `${NEWS_BASE[lang]}/${slug}` },
      props: { kind: 'news', entry },
    });
  }

  return out;
}

const { kind, entry } = Astro.props as { kind: string; entry?: any };
const { lang } = Astro.params as { lang: Lang };
const other: Lang = lang === 'fr' ? 'de' : 'fr';

const rendered = kind === 'page' || kind === 'news' ? await render(entry) : null;
const Content = rendered?.Content;

const coverSize = entry?.data?.cover ? imageSize(entry.data.cover) : null;
const coverEmblem = isEmblem(coverSize);

// Une rubrique du menu affiche le sommaire de ses pages, qu'elle ait ou non
// une introduction.
const sectionChildren = kind === 'page' ? await childrenOf(entry.data.key, lang) : [];
const showsIndex = sectionChildren.length > 0;
const stillToWrite = kind === 'page' && entry.data.draft && !showsIndex;

// Le fil d'Ariane : accueil › rubrique › page, d'après le menu.
const crumbs: { label: string; href: string | null }[] = [{ label: UI.home[lang], href: path(lang) }];
if (kind === 'page') {
  const parent = NAV.find((i) => i.children?.some((c) => c.key === entry.data.key));
  if (parent?.key) crumbs.push({ label: parent.label[lang], href: await pathFor(parent.key, lang) });
}

// La liste des actualités et la recherche existent dans les deux langues :
// on donne leur jumelle au gabarit, pour le sélecteur de langue et le hreflang.
const implantationsHref = kind === 'page' && entry.data.map ? await pathFor('nos-implantations', lang) : null;

const routeTwin =
  kind === 'news-index' ? path(other, NEWS_BASE[other]) : kind === 'search' ? path(other, SEARCH_BASE[other]) : undefined;
---

{kind === 'search' && (
  <BaseLayout title={UI.search[lang]} lang={lang} noindex twinHref={routeTwin}>
    <div class="ses-page-head">
      <div class="ses-col ses-col--narrow">
        <h1>{UI.search[lang]}</h1>
        <p class="ses-lead mt-3">{UI.searchIntro[lang]}</p>
      </div>
    </div>
    <div class="ses-col ses-col--narrow ses-section"><Search lang={lang} /></div>
  </BaseLayout>
)}

{kind === 'news-index' && (
  <BaseLayout title={UI.news[lang]} lang={lang} twinHref={routeTwin}>
    <div class="ses-page-head">
      <div class="ses-col">
        <ol class="ses-crumbs"><li><a href={path(lang)}>{UI.home[lang]}</a></li><li>{UI.news[lang]}</li></ol>
        <h1>{UI.news[lang]}</h1>
        <p class="ses-lead mt-3">{UI.latestNews[lang]}</p>
      </div>
    </div>
    <div class="ses-col ses-section"><NewsList lang={lang} /></div>
  </BaseLayout>
)}

{kind === 'news' && (
  <BaseLayout
    title={entry.data.title}
    description={entry.data.summary}
    lang={lang}
    ogType="article"
    image={entry.data.cover}
    noindex={entry.data.draft}
  >
    <NewsArticle entry={entry} lang={lang}>
      <Content />
    </NewsArticle>
  </BaseLayout>
)}

{kind === 'page' && (
  <BaseLayout
    title={entry.data.title}
    description={entry.data.description}
    lang={lang}
    pageKey={entry.data.key}
    noindex={stillToWrite}
  >
    <article>
      <div class="ses-page-head">
        <div class:list={['ses-col', !showsIndex && !entry.data.map && 'ses-col--narrow']}>
          <ol class="ses-crumbs">
            {crumbs.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : c.label}</li>)}
            <li aria-current="page">{entry.data.title}</li>
          </ol>
          {entry.data.branche && (
            <div class="ses-head-icons">
              {BRANCHES[entry.data.branche].map((icon) => (
                <BrancheIcon icon={icon} size="4rem" lang={lang} decorative={false} />
              ))}
            </div>
          )}
          <h1>{entry.data.title}</h1>
          {entry.data.description && <p class="ses-lead mt-3">{entry.data.description}</p>}
        </div>
      </div>

      <div class:list={['ses-col', 'ses-section', !showsIndex && !entry.data.map && 'ses-col--narrow']} style="padding-top: var(--space-4)">
        {entry.data.cover && (
          <img
            src={withBase(entry.data.cover)}
            alt={entry.data.coverAlt ?? ''}
            class:list={['ses-cover', coverEmblem && 'ses-cover--ecusson']}
            width={coverSize?.w}
            height={coverSize?.h}
            loading="eager"
          />
        )}
        <PageNotices lang={lang} draft={stillToWrite} translated={entry.data.translated} />
        <div class="ses-prose">
          <Content />
        </div>
        {showsIndex && <SectionIndex lang={lang} pages={sectionChildren} />}
        {/* La page des implantations reçoit l'explorateur complet ; la
            rubrique « Nous rejoindre » une carte compacte qui y mène. */}
        {entry.data.map && entry.data.key === 'nos-implantations' && (
          <div class="mt-8"><ImplantationsExplorer lang={lang} /></div>
        )}
        {entry.data.map && entry.data.key !== 'nos-implantations' && (
          <div class="mt-10"><SwissMap lang={lang} moreHref={implantationsHref} /></div>
        )}
        {entry.data.contactForm && <div class="mt-8"><ContactBlock lang={lang} /></div>}
      </div>
    </article>
  </BaseLayout>
)}

<style>
  .ses-head-icons { display: flex; gap: 0.75rem; margin-bottom: var(--space-2); }
  .ses-cover { display: block; max-width: 100%; height: auto; border-radius: var(--radius-2); margin-bottom: var(--space-3); }
  .ses-cover--ecusson { max-width: 8rem; }
  .ses-cover:not(.ses-cover--ecusson) { max-width: 36rem; }
</style>
