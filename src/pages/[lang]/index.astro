---
/**
 * La page d'accueil, dans chaque langue. Son texte vient de
 * src/content/pages/<langue>/home.md ; la mise en page est ici.
 */
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageNotices from '../../components/PageNotices.astro';
import NewsList from '../../components/NewsList.astro';
import Slider from '../../components/Slider.astro';
import { pathFor } from '../../lib/pages';
import { LANGS, NAV, NEWS_BASE, UI, withBase, type Lang } from '../../data/site';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };

const entry = await getEntry('pages', `${lang}/home`);
if (!entry) throw new Error(`Page d'accueil manquante : ${lang}/home`);
const { Content } = await render(entry);

/**
 * On retrouve les entrées du menu PAR CLÉ, jamais par position : les indices
 * (NAV[0], NAV[2]) se sont cassés dès que l'ordre du menu a changé, et la
 * page d'accueil s'est mise à afficher « Accueil » en titre de section et les
 * clés brutes à la place des noms de branches.
 */
const entry_ = (key: string) => NAV.find((i) => i.key === key);
const childOf = (parent: string, key: string) =>
  entry_(parent)?.children?.find((c) => c.key === key);

const branchNav = entry_('notre-scoutisme')?.children ?? [];
const branches = (
  await Promise.all(
    [
      { key: 'branche-jaune', couleur: 'var(--ses-branche-jaune)', ecusson: '/images/branche-jaune.png' },
      { key: 'branche-verte', couleur: 'var(--ses-branche-verte)', ecusson: '/images/branche-verte.png' },
      { key: 'branche-rouge', couleur: 'var(--ses-branche-rouge)', ecusson: '/images/branche-rouge.png' },
    ].map(async (b) => ({
      ...b,
      href: await pathFor(b.key, lang),
      label: branchNav.find((c) => c.key === b.key)?.label[lang] ?? b.key,
    })),
  )
).filter((b) => b.href);

const joinHref = await pathFor('nous-rejoindre', lang);
const joinLabel = entry_('nous-rejoindre')?.label[lang] ?? '';
const scoutingLabel = entry_('notre-scoutisme')?.label[lang] ?? '';
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  lang={lang}
  fullWidth
  pageKey="home"
  noindex={entry.data.draft}
>
  <!-- Le bandeau défilant, directement sous le menu, comme sur le site
       actuel. Il remplace le bandeau rouge que j'avais dessiné. -->
  <Slider lang={lang} />


  <div class="ses-col py-10">
    <h1 style="font-size: var(--text-h1)">{entry.data.title}</h1>
    {entry.data.description && (
      <p class="mt-2 ses-prose" style="color: var(--ses-muted)">{entry.data.description}</p>
    )}

    <PageNotices lang={lang} draft={entry.data.draft} translated={entry.data.translated} />

    <div class="ses-prose">
      <Content />
    </div>

    <h2 class="mt-12" style="font-size: var(--text-h2)">{scoutingLabel}</h2>
    <ul class="mt-4 grid gap-4 sm:grid-cols-3">
      {branches.map((b) => (
        <li
          class="border p-5 text-center"
          style={`border-color: var(--ses-border); background: var(--ses-surface); border-top: 4px solid ${b.couleur}`}
        >
          <img src={withBase(b.ecusson)} alt="" width="104" height="104" class="mx-auto mb-3" style="width: 5rem; height: auto" />
          <a href={b.href} class="font-semibold no-underline" style="color: var(--ses-fg)">{b.label}</a>
        </li>
      ))}
    </ul>

    <h2 class="mt-12" style="font-size: var(--text-h2)">{UI.news[lang]}</h2>
    <NewsList lang={lang} limit={3} heading={false} />
    <p class="mt-4">
      <a href={withBase(`/${lang}/${NEWS_BASE[lang]}/`)}>{UI.allNews[lang]}</a>
    </p>
  </div>
</BaseLayout>

