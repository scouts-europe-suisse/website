---
/**
 * Le gabarit commun à toutes les pages : <head>, en-tête, pied de page.
 *
 * Toute page passe par ici. Ce qui est propre à une page (titre, résumé)
 * arrive en propriété ; ce qui est commun (langue, jumelle dans l'autre
 * langue, données pour les moteurs de recherche) est calculé ici une fois.
 */
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, type Lang } from '../data/site';
import { twinOf } from '../lib/pages';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang: Lang;
  /** true = pas de bandeau ni de colonne autour du contenu (page d'accueil). */
  fullWidth?: boolean;
  ogType?: 'website' | 'article';
  /**
   * true = demander aux moteurs de recherche d'ignorer la page.
   * Mis d'office sur les ébauches : une page dont le contenu reste à écrire
   * n'a rien à faire dans les résultats de recherche, et une fois indexée
   * elle y reste des semaines après avoir été corrigée.
   */
  noindex?: boolean;
  /**
   * La clé de la page, qui permet de retrouver sa jumelle dans l'autre
   * langue. Sans elle, le sélecteur de langue renvoie vers l'accueil : c'est
   * le cas des pages qui n'ont pas d'équivalent (une actualité non traduite).
   */
  pageKey?: string;
}

const { title, description, lang, fullWidth = false, ogType = 'website', noindex = false, pageKey } =
  Astro.props;

const siteUrl = (Astro.site ?? new URL(SITE.domain)).origin;
const canonical = new URL(Astro.url.pathname, siteUrl).href;

// Le titre d'onglet se termine toujours par le nom du mouvement, sans le
// répéter quand la page le contient déjà.
const fullTitle = title.includes(SITE.shortName) || title.includes(SITE.name)
  ? title
  : `${title} · ${SITE.name}`;

const defaultDescription: Record<Lang, string> = {
  fr: `${SITE.name} — le scoutisme européen en Suisse : nos branches, notre projet éducatif, et comment nous rejoindre.`,
  de: `${SITE.name} — europäisches Pfadfindertum in der Schweiz.`,
};

// La page équivalente dans l'autre langue. Les deux adresses n'ayant rien en
// commun (/fr/branche-jaune/ ↔ /de/woelflingsstufe/), on passe par la clé.
// Sert au sélecteur de langue et aux balises hreflang, qui évitent que les
// deux versions soient prises pour du contenu dupliqué.
const twin = pageKey ? await twinOf(pageKey, lang) : null;
const otherLang: Lang = lang === 'fr' ? 'de' : 'fr';
const alternates = [
  { lang, href: new URL(Astro.url.pathname, siteUrl).href },
  ...(twin ? [{ lang: otherLang, href: new URL(twin, siteUrl).href }] : []),
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description ?? defaultDescription[lang]} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link
      rel="alternate"
      hreflang="x-default"
      href={(alternates.find((a) => a.lang === 'fr') ?? alternates[0]).href}
    />

    <!-- Icônes : le vrai emblème carré du mouvement, repris du site actuel.
         Le .ico (16/32/48) reste utile aux navigateurs anciens et aux
         agrégateurs de flux, qui ne lisent que celui-là. -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-192x192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description ?? defaultDescription[lang]} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_CH' : 'de_CH'} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body>
    <a href="#contenu" class="ses-skip">
      {lang === 'fr' ? 'Aller au contenu' : 'Zum Inhalt springen'}
    </a>

    <!-- La colonne blanche posée sur le fond gris : c'est la mise en page de
         l'ancien site, sa signature visuelle la plus reconnaissable. -->
    <div class="ses-sheet">
      <Header lang={lang} twin={twin} />

      <main id="contenu" class={fullWidth ? '' : 'ses-col py-10'}>
        <slot />
      </main>

      <Footer lang={lang} />
    </div>
  </body>
</html>
