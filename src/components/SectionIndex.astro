---
/**
 * Le sommaire d'une rubrique : ses sous-pages en cartes, avec leur résumé.
 * Les pages de branche montrent leur pictogramme à la couleur de la branche.
 */
import { getCollection } from 'astro:content';
import type { PageRef } from '../lib/pages';
import { UI, withBase, type Lang } from '../data/site';
import { BRANCHES } from '../data/pictos';
import BrancheIcon from './BrancheIcon.astro';

interface Props {
  lang: Lang;
  pages: PageRef[];
}
const { lang, pages } = Astro.props;

const entries = await getCollection('pages');
const meta = (key: string) => entries.find((e) => e.data.key === key && e.id.startsWith(`${lang}/`))?.data;
---

{pages.length > 0 && (
  <section class="ses-section-index" aria-label={UI.inThisSection[lang]}>
    <p class="ses-eyebrow">{UI.inThisSection[lang]}</p>
    <ul class="ses-index-grid">
      {pages.map((p) => {
        const m = meta(p.key);
        const branche = m?.branche;
        return (
          <li class:list={['ses-card', branche && 'ses-card--accent']} style={branche ? `--accent: var(--ses-branche-${branche})` : undefined}>
            <div class="ses-card__body">
              {branche && (
                <div class="ses-index-icons">
                  {BRANCHES[branche].map((icon) => <BrancheIcon icon={icon} size="3rem" lang={lang} />)}
                </div>
              )}
              <h3 class="ses-card__title"><a href={withBase(`/${lang}/${p.slug}/`)}>{p.title}</a></h3>
              {m?.description && <p class="ses-muted ses-small">{m.description}</p>}
            </div>
          </li>
        );
      })}
    </ul>
  </section>
)}

<style>
  .ses-section-index { margin-top: var(--space-4); }
  .ses-index-grid {
    margin-top: var(--space-2);
    display: grid;
    gap: var(--space-2);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
  }
  .ses-index-icons { display: flex; gap: 0.5rem; margin-bottom: 0.25rem; }
</style>
