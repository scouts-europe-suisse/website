---
/**
 * Les actualités d'une langue, en cartes, de la plus récente à la plus
 * ancienne. Une carte sans image de couverture reçoit un fond aux couleurs
 * du mouvement plutôt qu'un trou.
 */
import { getCollection } from 'astro:content';
import { CROSS, NEWS_BASE, UI, withBase, type Lang } from '../data/site';

interface Props {
  lang: Lang;
  limit?: number;
}
const { lang, limit } = Astro.props;

const all = (await getCollection('news', (e) => e.id.startsWith(`${lang}/`) && !e.data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const articles = limit ? all.slice(0, limit) : all;
const fmt = (d: Date) =>
  d.toLocaleDateString(lang === 'fr' ? 'fr-CH' : 'de-CH', { day: 'numeric', month: 'long', year: 'numeric' });
---

{articles.length === 0 ? (
  <p class="ses-muted">{UI.noNews[lang]}</p>
) : (
  <ul class="ses-news-grid">
    {articles.map((a) => (
      <li class="ses-card ses-reveal">
        <div class="ses-card__media">
          {a.data.cover ? (
            <img src={withBase(a.data.cover)} alt="" loading="lazy" decoding="async" />
          ) : (
            <div class="ses-news-placeholder" aria-hidden="true">
              <img src={withBase(CROSS)} alt="" width="64" height="64" />
            </div>
          )}
        </div>
        <div class="ses-card__body">
          <p class="ses-small ses-muted">
            <time datetime={a.data.date.toISOString()}>{fmt(a.data.date)}</time>
          </p>
          <h3 class="ses-card__title">
            <a href={withBase(`/${lang}/${NEWS_BASE[lang]}/${a.id.split('/')[1]}/`)}>{a.data.title}</a>
          </h3>
          {a.data.summary && <p class="ses-muted ses-news-summary">{a.data.summary}</p>}
        </div>
      </li>
    ))}
  </ul>
)}

<style>
  .ses-news-grid {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
  }
  .ses-news-placeholder {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    background:
      radial-gradient(circle at 20% 20%, color-mix(in srgb, var(--ses-gold) 30%, transparent), transparent 55%),
      linear-gradient(135deg, var(--ses-page-alt), #e9e4da);
  }
  .ses-news-placeholder img { width: 4rem; height: auto; opacity: 0.9; }
  .ses-news-summary {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
