---
/**
 * Le bandeau défilant de la page d'accueil, comme sur le site actuel.
 *
 * Deux principes :
 *
 * 1. **Il marche sans JavaScript.** Les vues sont dans un conteneur qui
 *    défile horizontalement avec accroche (`scroll-snap`) : sans script, on
 *    fait défiler à la main et tout reste accessible. Le script n'ajoute que
 *    l'avance automatique et les pastilles.
 * 2. **Il respecte `prefers-reduced-motion`.** Une personne qui a demandé
 *    moins d'animations ne subit pas de défilement automatique — c'est un
 *    réglage d'accessibilité, pas une préférence esthétique.
 *
 * Les photos sont celles où personne n'est identifiable. Le bandeau du site
 * actuel montre surtout des scouts de face : ces vues attendent la
 * vérification des autorisations parentales, d'où une rotation plus courte
 * ici. Voir _migrations/images/README.md.
 */
import { withBase, type Lang } from '../data/site';
import { pathFor } from '../lib/pages';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// Les six vues du bandeau de l'ancien site, dans son ordre, avec le lien que
// chacune portait vers sa rubrique. Relevées sur le site en ligne le
// 2026-09-10 ; les autorisations sont confirmées (voir le plan 04).
const SLIDES = [
  { img: '/images/chapelle-montagne.jpg',  key: 'mouvement',
    fr: 'Le mouvement',                de: 'Die Bewegung' },
  { img: '/images/devenir-chef.jpg',       key: 'notre-scoutisme',
    fr: 'Notre scoutisme',             de: 'Unsere Pfadfinderschaft' },
  { img: '/images/0047.jpg',               key: 'branche-jaune',
    fr: 'Louveteaux et louvettes',     de: 'Wölflinge' },
  { img: '/images/dscn0566.jpg',           key: 'branche-verte',
    fr: 'Éclaireurs et éclaireuses',   de: 'Pfadfinder' },
  { img: '/images/montee-silhouettes.jpg', key: 'branche-rouge',
    fr: 'Routiers et guides-aînées',   de: 'Rover und Ranger' },
  { img: '/images/drapeaux.jpg',           key: 'dimension-europeenne',
    fr: 'La dimension européenne',     de: 'Die europäische Dimension' },
];

// Chaque vue mène à sa rubrique, comme sur l'ancien site.
const slides = await Promise.all(
  SLIDES.map(async (s) => ({ ...s, href: await pathFor(s.key, lang) })),
);

const label = lang === 'fr' ? 'Images du mouvement' : 'Bilder der Bewegung';
const prev = lang === 'fr' ? 'Image précédente' : 'Vorheriges Bild';
const next = lang === 'fr' ? 'Image suivante' : 'Nächstes Bild';
const goto = lang === 'fr' ? 'Aller à l’image' : 'Zum Bild';
---

<section class="ses-slider" aria-roledescription="carrousel" aria-label={label}>
  <div class="ses-slides" id="ses-slides">
    {slides.map((s, i) => (
      <figure
        class="ses-slide"
        id={`slide-${i}`}
        aria-roledescription="diapositive"
        aria-label={`${i + 1} / ${slides.length}`}
      >
        <a href={s.href ?? '#'}>
          <img
            src={withBase(s.img)}
            alt={lang === 'fr' ? s.fr : s.de}
            width="1200"
            height="514"
            loading={i === 0 ? 'eager' : 'lazy'}
          />
          <figcaption>{lang === 'fr' ? s.fr : s.de}</figcaption>
        </a>
      </figure>
    ))}
  </div>

  <button class="ses-slider-nav ses-prev" type="button" aria-label={prev} hidden>‹</button>
  <button class="ses-slider-nav ses-next" type="button" aria-label={next} hidden>›</button>

  <div class="ses-dots" role="tablist" aria-label={label} hidden>
    {slides.map((_, i) => (
      <button type="button" role="tab" aria-label={`${goto} ${i + 1}`} data-i={i}
              aria-selected={i === 0 ? 'true' : 'false'}></button>
    ))}
  </div>
</section>

<script is:inline>
  (function () {
    var root = document.currentScript.previousElementSibling;
    var strip = root.querySelector('.ses-slides');
    var slides = Array.prototype.slice.call(root.querySelectorAll('.ses-slide'));
    var dots = Array.prototype.slice.call(root.querySelectorAll('.ses-dots button'));
    if (slides.length < 2) return;

    root.querySelectorAll('[hidden]').forEach(function (el) { el.hidden = false; });

    var i = 0;
    function show(n, smooth) {
      i = (n + slides.length) % slides.length;
      strip.scrollTo({ left: slides[i].offsetLeft, behavior: smooth === false ? 'auto' : 'smooth' });
      dots.forEach(function (d, k) { d.setAttribute('aria-selected', k === i ? 'true' : 'false'); });
    }
    root.querySelector('.ses-prev').addEventListener('click', function () { show(i - 1); stop(); });
    root.querySelector('.ses-next').addEventListener('click', function () { show(i + 1); stop(); });
    dots.forEach(function (d) {
      d.addEventListener('click', function () { show(Number(d.dataset.i)); stop(); });
    });

    // Suivre le défilement manuel pour garder les pastilles justes.
    var t;
    strip.addEventListener('scroll', function () {
      clearTimeout(t);
      t = setTimeout(function () {
        var near = 0, best = Infinity;
        slides.forEach(function (s, k) {
          var d = Math.abs(s.offsetLeft - strip.scrollLeft);
          if (d < best) { best = d; near = k; }
        });
        i = near;
        dots.forEach(function (d, k) { d.setAttribute('aria-selected', k === i ? 'true' : 'false'); });
      }, 120);
    });

    // Avance automatique : jamais si la personne a demandé moins d'animations.
    var timer = null;
    var calm = window.matchMedia('(prefers-reduced-motion: reduce)');
    function start() { if (!calm.matches && !timer) timer = setInterval(function () { show(i + 1); }, 6000); }
    function stop() { clearInterval(timer); timer = null; }
    root.addEventListener('mouseenter', stop);
    root.addEventListener('focusin', stop);
    root.addEventListener('mouseleave', start);
    calm.addEventListener('change', function () { stop(); start(); });
    start();
  })();
</script>

<style>
  .ses-slider { position: relative; background: #000; }
  .ses-slides {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .ses-slides::-webkit-scrollbar { display: none; }
  .ses-slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    margin: 0;
    position: relative;
  }
  .ses-slide img {
    display: block;
    width: 100%;
    height: clamp(14rem, 34vw, 26rem);
    object-fit: cover;
  }
  .ses-slide a { display: block; color: inherit; text-decoration: none; }
  .ses-slide figcaption {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    background: rgb(0 0 0 / 0.45);
    color: #fff;
    padding: 0.55rem 1.4rem;
    font-size: var(--text-small);
    text-align: center;
    max-width: 90%;
  }
  .ses-slider-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 2.4rem; height: 3.2rem;
    border: 0;
    background: rgb(0 0 0 / 0.35);
    color: #fff;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
  }
  .ses-slider-nav:hover { background: rgb(0 0 0 / 0.6); }
  .ses-prev { left: 0; }
  .ses-next { right: 0; }
  .ses-dots {
    position: absolute;
    left: 50%;
    bottom: 0.45rem;
    transform: translateX(-50%);
    display: flex;
    gap: 0.4rem;
    z-index: 2;
  }
  .ses-dots button {
    width: 0.62rem; height: 0.62rem;
    border-radius: 50%;
    border: 0;
    background: rgb(255 255 255 / 0.55);
    cursor: pointer;
    padding: 0;
  }
  .ses-dots button[aria-selected='true'] { background: #fff; }
</style>
