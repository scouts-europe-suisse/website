---
/**
 * Les deux langues, écrites en toutes lettres, comme sur le site actuel :
 * un germanophone qui tombe sur une page française doit voir « Deutsch », pas
 * un code à deviner.
 *
 * L'adresse de la jumelle est calculée par le gabarit (via la clé de la page).
 * Quand la page n'existe pas dans l'autre langue, le lien mène à l'accueil de
 * cette langue plutôt que vers une page inexistante, et le dit.
 */
import { LANGS, LANG_LABELS, path, type Lang } from '../data/site';

interface Props {
  lang: Lang;
  twin?: string | null;
}
const { lang, twin } = Astro.props;
const other: Lang = lang === 'fr' ? 'de' : 'fr';
---

<ul class="flex flex-col items-end text-sm leading-tight">
  {LANGS.map((l) => (
    <li>
      {l === lang ? (
        <span style="color: var(--ses-muted)" aria-current="true">{LANG_LABELS[l]}</span>
      ) : (
        <a
          href={twin ?? path(other)}
          hreflang={l}
          lang={l}
          title={twin
            ? LANG_LABELS[l]
            : l === 'de'
              ? 'Diese Seite gibt es noch nicht auf Deutsch — zur Startseite'
              : "Cette page n'existe pas encore en français — aller à l'accueil"}
        >
          {LANG_LABELS[l]}
        </a>
      )}
    </li>
  ))}
</ul>
