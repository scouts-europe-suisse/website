---
/**
 * En-tête du site : logo, menu principal à deux niveaux, sélecteur de langue.
 *
 * Le menu est lu depuis src/data/site.ts — ne pas recopier d'items ici.
 * Sur téléphone, il se replie derrière un bouton ; le pliage est fait avec
 * <details>, donc il fonctionne même sans JavaScript.
 */
import { NAV, SITE, SOCIAL, UI, path, type NavItem, type Lang } from '../data/site';
import { pathFor } from '../lib/pages';
import LangSwitcher from './LangSwitcher.astro';

interface Props {
  lang: Lang;
  twin?: string | null;
}
const { lang, twin } = Astro.props;
const here = Astro.url.pathname;

/**
 * Résout le menu pour la langue courante : chaque entrée porte une clé, dont
 * l'adresse dépend de la langue. Une entrée dont la page n'existe pas dans
 * cette langue est retirée du menu plutôt que de mener à une page absente.
 */
async function resolve(item: NavItem) {
  const href = item.route ? path(lang, item.route[lang]) : await pathFor(item.key!, lang);
  const children = [];
  for (const c of item.children ?? []) {
    const h = c.route ? path(lang, c.route[lang]) : await pathFor(c.key!, lang);
    if (h) children.push({ label: c.label[lang], href: h });
  }
  return href ? { label: item.label[lang], href, children } : null;
}
const nav = (await Promise.all(NAV.map(resolve))).filter((x) => x !== null);

/**
 * Une entrée est active sur sa page et ses sous-pages. L'accueil fait
 * exception : son adresse est le préfixe de toutes les autres, donc on exige
 * une correspondance exacte, sinon il resterait allumé partout.
 */
const home = path(lang);
function isActive(href: string): boolean {
  return href === home ? here === home : here === href || here.startsWith(href);
}
---

<!-- `relative` ancre le menu déplié du téléphone, qui est en position absolue. -->
<header class="relative border-b" style="border-color: var(--ses-border); background: var(--ses-surface)">
  <div class="ses-col flex items-center justify-between gap-4 py-3">
    <!-- Le logo porte déjà le nom du mouvement : pas de texte à côté, qui
         ferait doublon à l'écran comme pour un lecteur d'écran. L'alt tient
         lieu de nom. -->
    <a href={path(lang)} class="inline-flex items-center no-underline">
      <img
        src="/images/logo-ses.png"
        alt={SITE.name}
        width="351"
        height="134"
        class="ses-logo"
      />
    </a>

    <div class="flex items-center gap-4">
      <div class="hidden sm:flex flex-col items-end leading-tight">
        <LangSwitcher lang={lang} twin={twin} />
      </div>

      <!-- Les comptes du mouvement. Demandés par le cahier des charges
           (partie 2, point 4). Simples liens : pas de widget embarqué, qui
           ferait partir des données du visiteur chez le réseau concerné. -->
      <ul class="hidden sm:flex items-center gap-2">
        {SOCIAL.map((s) => (
          <li>
            <a
              href={s.url}
              target="_blank"
              rel="noopener"
              class="ses-social"
              title={s.name}
              aria-label={s.name}
            >
              {s.name.charAt(0)}
            </a>
          </li>
        ))}
      </ul>

      <!-- Menu replié sur téléphone, déplié à partir de la tablette. -->
      <details class="lg:hidden ses-mobile-nav">
        <summary
          class="list-none cursor-pointer inline-flex items-center justify-center min-w-11 min-h-11 font-semibold"
          aria-label={UI.menu[lang]}
        >
          {UI.menu[lang]}
        </summary>
        <nav class="ses-mobile-panel" aria-label={UI.menu[lang]}>
          <ul>
            {nav.map((item) => (
              <li>
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
                {item.children.length > 0 && (
                  <ul>
                    {item.children.map((child) => (
                      <li>
                        <a href={child.href}>{child.label}</a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>

  <!-- Menu horizontal, à partir du grand écran. -->
  <nav class="ses-navbar hidden lg:block" aria-label={UI.menu[lang]}>
    <ul class="ses-col flex flex-wrap items-stretch gap-1">
      {nav.map((item) => (
        <li class:list={['relative', 'ses-nav-item', isActive(item.href) && 'is-active']}>
          <a
            href={item.href}
            class="inline-flex items-center px-4 py-3 font-semibold no-underline"
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
          {item.children.length > 0 && (
            <ul class="ses-submenu">
              {item.children.map((child) => (
                <li>
                  <a href={child.href}>{child.label}</a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  /* Pastilles des réseaux sociaux : une initiale dans un rond gris, comme
     sur le site actuel, sans charger d'icônes depuis un service tiers. */
  .ses-social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    background: #c9c9c9;
    color: #ffffff;
    font-weight: 700;
    font-size: 0.85rem;
    text-decoration: none;
    transition: background-color 120ms ease;
  }
  .ses-social:hover { background: var(--ses-primary); color: #fff; }

  /* Le logo est fourni en 351×134. On le pose à une hauteur fixe et on
     laisse la largeur suivre, pour qu'il ne se déforme jamais. */
  .ses-logo {
    height: 3.25rem;
    width: auto;
  }
  @media (max-width: 26rem) {
    .ses-logo { height: 2.5rem; }
  }

  /* Le triangle par défaut du <details> : retiré, le mot « Menu » suffit. */
  .ses-mobile-nav summary::-webkit-details-marker { display: none; }

  .ses-mobile-panel {
    position: absolute;
    left: 0;
    right: 0;
    z-index: 50;
    background: var(--ses-surface);
    border-bottom: 1px solid var(--ses-border);
    padding: var(--space-2) var(--space-3);
    max-height: 75vh;
    overflow-y: auto;
  }
  .ses-mobile-panel a {
    display: block;
    padding: 0.6rem 0;
    text-decoration: none;
    color: var(--ses-fg);
  }
  .ses-mobile-panel ul ul a {
    padding-left: var(--space-2);
    color: var(--ses-muted);
    font-size: var(--text-small);
  }

  /* Sous-menu du grand écran : ouvert au survol et au focus clavier, pour
     qu'il soit atteignable autrement qu'à la souris. */
  .ses-submenu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 15rem;
    background: var(--ses-surface);
    border: 1px solid var(--ses-border);
    border-top: 3px solid var(--ses-primary);
    padding: var(--space-1) 0;
    z-index: 40;
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.08);
  }
  .ses-nav-item:hover > .ses-submenu,
  .ses-nav-item:focus-within > .ses-submenu {
    display: block;
  }
  .ses-submenu a {
    display: block;
    padding: 0.45rem var(--space-2);
    text-decoration: none;
    color: var(--ses-fg);
    font-size: var(--text-small);
  }
  .ses-submenu a:hover {
    background: color-mix(in srgb, var(--ses-primary) 8%, transparent);
    color: var(--ses-primary);
  }
</style>
