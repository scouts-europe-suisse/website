---
/**
 * La carte des implantations.
 *
 * C'est la carte du mouvement elle-même : un « Google My Maps » que le SES
 * tient à jour, déjà embarqué sur l'ancien site. Elle est reprise **telle
 * quelle**, chargée directement, comme le faisait l'ancien site
 * (décision de Perki, 2026-09-10).
 *
 * À savoir, si la question de la protection des données revient un jour :
 * l'iframe contacte Google dès l'ouverture de la page, donc l'adresse IP du
 * visiteur part avant qu'il ait rien fait. Un chargement au clic réglerait ce
 * point sans changer la carte ; le choix a été de rester au plus près de
 * l'existant. `referrerpolicy="no-referrer"` limite au moins ce qui est
 * transmis avec la requête.
 */
import type { Lang } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// Identifiant de la carte du mouvement, repris de l'ancien site.
const MAP_ID = 'zfTykSxVYwRo.kXJ56xQzar0I';
const SRC = `https://www.google.com/maps/d/embed?mid=${MAP_ID}`;
const titre = lang === 'fr' ? 'Carte de nos implantations' : 'Karte unserer Standorte';
---

<div class="ses-map not-prose">
  <iframe
    src={SRC}
    title={titre}
    width="100%"
    height="480"
    loading="lazy"
    referrerpolicy="no-referrer"
    style="border: 0"
  ></iframe>
</div>

<style>
  .ses-map { margin-top: var(--space-3); }
  .ses-map iframe { display: block; width: 100%; }
</style>
