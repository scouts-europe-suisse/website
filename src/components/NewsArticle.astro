---
/** Une actualité : titre, date, image de couverture créditée, puis le texte. */
import PageNotices from './PageNotices.astro';
import { NEWS_BASE, UI, type Lang } from '../data/site';

interface Props {
  entry: any;
  lang: Lang;
}
const { entry, lang } = Astro.props;
const d = entry.data;
---

<article>
  <p style="color: var(--ses-muted); font-size: var(--text-small)">
    <a href={`/${lang}/${NEWS_BASE[lang]}/`}>{UI.news[lang]}</a>
  </p>
  <h1 class="mt-2" style="font-size: var(--text-h1)">{d.title}</h1>
  <p class="mt-2" style="color: var(--ses-muted); font-size: var(--text-small)">
    <time datetime={d.date.toISOString()}>
      {d.date.toLocaleDateString(lang === 'fr' ? 'fr-CH' : 'de-CH', {
        day: 'numeric',
        month: 'long',
        year: 'numeric',
      })}
    </time>
    {d.author && <> · {d.author}</>}
  </p>

  {d.cover && (
    <figure class="mt-6">
      <img src={d.cover} alt="" style="max-width: 100%; height: auto" />
      {/* Le crédit n'est jamais facultatif dès qu'il y a une image. */}
      {d.coverCredit && (
        <figcaption style="color: var(--ses-muted); font-size: var(--text-small)">
          <Fragment set:html={d.coverCredit} />
        </figcaption>
      )}
    </figure>
  )}

  <div class="mt-6">
    <PageNotices lang={lang} draft={d.draft} translated={d.translated} />
    <div class="ses-prose">
      <slot />
    </div>
  </div>
</article>
