---
/**
 * Les dernières photos Instagram du mouvement (issue #21, visionneuse #71).
 *
 * Les données viennent de src/data/instagram.json et les images de
 * public/images/instagram/, tous deux écrits par `npm run instagram`. Rien
 * n'est chargé depuis Meta dans le navigateur du visiteur.
 *
 * Chaque vignette ouvre la publication dans une visionneuse (<dialog>)
 * centrée sur l'écran, en deux volets : la photo sur fond sombre, et un
 * volet clair « à la Instagram » avec le compte, la date, le texte complet
 * de la publication et le lien vers Instagram. Un album se feuillette par
 * les flèches, le clavier, le doigt ou la bande de vignettes ; au bout d'un
 * album on enchaîne sur la publication suivante. Sans JavaScript, la
 * vignette mène à la publication sur Instagram.
 */
import { SITE, SOCIAL, UI, withBase, type Lang } from '../data/site';
import instagram from '../data/instagram.json';

interface Props {
  lang: Lang;
  limit?: number;
}
const { lang, limit = 8 } = Astro.props;

const posts = instagram.posts.slice(0, limit).map((p) => ({
  ...p,
  date: new Date(p.timestamp).toLocaleDateString(lang === 'fr' ? 'fr-CH' : 'de-CH', { day: 'numeric', month: 'long', year: 'numeric' }),
  images: p.images.map((i) => ({ ...i, src: withBase(`/images/instagram/${i.file}`), thumb: withBase(`/images/instagram/${i.thumb ?? i.file}`) })),
}));
const account = SOCIAL.find((s) => s.icon === 'instagram')?.url ?? 'https://www.instagram.com/';
const t = {
  open: UI.openPhoto[lang], close: UI.closePhoto[lang], prev: UI.prevPhoto[lang], next: UI.nextPhoto[lang],
  prevPost: UI.prevPost[lang], nextPost: UI.nextPost[lang], prevShort: UI.prevShort[lang], nextShort: UI.nextShort[lang], view: UI.viewOnInstagram[lang],
  photo: UI.photoN[lang], of: UI.ofN[lang], handle: UI.instagramHandle[lang], name: SITE.name[lang],
};
const IG_ICON = 'M12 0C8.74 0 8.333.015 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.012 8.333 0 8.74 0 12s.015 3.667.072 4.947c.06 1.277.261 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.988 8.74 24 12 24s3.667-.015 4.947-.072c1.277-.06 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.06-1.28.072-1.687.072-4.947s-.015-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.319 1.347 20.651.935 19.86.63c-.765-.297-1.636-.499-2.913-.558C15.667.012 15.26 0 12 0zm0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.266.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.061 1.17-.256 1.805-.421 2.227-.224.562-.479.96-.899 1.382-.419.419-.824.679-1.38.896-.42.164-1.065.36-2.235.413-1.274.057-1.649.07-4.859.07-3.211 0-3.586-.015-4.859-.074-1.171-.061-1.816-.256-2.236-.421-.569-.224-.96-.479-1.379-.899-.421-.419-.69-.824-.9-1.38-.165-.42-.359-1.065-.42-2.235-.045-1.26-.061-1.649-.061-4.844 0-3.196.016-3.586.061-4.861.061-1.17.255-1.814.42-2.234.21-.57.479-.96.9-1.381.419-.419.81-.689 1.379-.898.42-.166 1.051-.361 2.221-.421 1.275-.045 1.65-.06 4.859-.06l.045.03zm0 3.678c-3.405 0-6.162 2.76-6.162 6.162 0 3.405 2.76 6.162 6.162 6.162 3.405 0 6.162-2.76 6.162-6.162 0-3.405-2.76-6.162-6.162-6.162zM12 16c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm7.846-10.405c0 .795-.646 1.44-1.44 1.44-.795 0-1.44-.646-1.44-1.44 0-.794.646-1.439 1.44-1.439.793-.001 1.44.645 1.44 1.439z';
---

{posts.length > 0 && (
  <div class="ses-insta" data-insta>
    <ul class="ses-insta__grid">
      {posts.map((p, i) => (
        <li class="ses-reveal" style={`transition-delay: ${Math.min(i, 7) * 40}ms`}>
          <a
            href={p.permalink}
            target="_blank"
            rel="noopener"
            class="ses-insta__tile"
            data-post={i}
            aria-label={`${t.open} — ${p.date}`}
          >
            {/* La vignette carrée de 600 px ; la photo entière ne se charge qu'en grand (issue #39). */}
            <img
              src={p.images[0].thumb}
              width="600"
              height="600"
              alt=""
              loading="lazy"
              decoding="async"
            />
            {p.album && (
              <span class="ses-insta__badge" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="7" width="14" height="14" rx="2"/><path d="M7 3h12a2 2 0 0 1 2 2v12"/></svg>
                {p.images.length}
              </span>
            )}
          </a>
        </li>
      ))}
    </ul>

    <dialog class="ses-lb" aria-label={t.open}>
      <div class="ses-lb__box" data-box tabindex="-1">
        <button type="button" class="ses-lb__close" data-close aria-label={t.close}>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>

        {/* Le volet photo */}
        <div class="ses-lb__media" data-media>
          <img class="ses-lb__img" data-img alt="" />
          <p class="ses-lb__count" data-count aria-live="polite"></p>
          <button type="button" class="ses-lb__arrow ses-lb__arrow--prev" data-prev aria-label={t.prev}>
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 5-7 7 7 7"/></svg>
          </button>
          <button type="button" class="ses-lb__arrow ses-lb__arrow--next" data-next aria-label={t.next}>
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 5 7 7-7 7"/></svg>
          </button>
          <div class="ses-lb__thumbs" data-thumbs role="tablist"></div>
        </div>

        {/* Le volet texte */}
        <aside class="ses-lb__side">
          <header class="ses-lb__head">
            <span class="ses-lb__avatar" aria-hidden="true"><img src={withBase('/images/croix-ses.svg')} alt="" width="40" height="40" /></span>
            <div class="ses-lb__who">
              <strong>{t.name}</strong>
              <a href={account} target="_blank" rel="noopener">{t.handle}</a>
            </div>
            <a class="ses-lb__ig" href={account} target="_blank" rel="noopener" aria-label="Instagram">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d={IG_ICON} /></svg>
            </a>
          </header>
          <div class="ses-lb__body">
            <p class="ses-lb__caption" data-caption></p>
          </div>
          <footer class="ses-lb__foot">
            <time class="ses-lb__date" data-date></time>
            <a class="ses-btn ses-btn--small ses-lb__view" data-link href="#" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d={IG_ICON} /></svg>
              {t.view}
            </a>
            <div class="ses-lb__posts">
              <button type="button" class="ses-lb__post" data-prev-post aria-label={t.prevPost} title={t.prevPost}>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg>
                <span>{t.prevShort}</span>
              </button>
              <button type="button" class="ses-lb__post" data-next-post aria-label={t.nextPost} title={t.nextPost}>
                <span>{t.nextShort}</span>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg>
              </button>
            </div>
          </footer>
        </aside>
      </div>
    </dialog>

    <script type="application/json" data-posts set:html={JSON.stringify({
      t: { photo: t.photo, of: t.of },
      posts: posts.map((p) => ({ caption: p.caption, permalink: p.permalink, date: p.date, images: p.images.map((i) => ({ src: i.src, thumb: i.thumb, w: i.w, h: i.h })) })),
    })} />
  </div>
)}

<script>
  (function () {
    const root = document.querySelector('[data-insta]');
    if (!root || !('HTMLDialogElement' in window)) return;
    const data = JSON.parse(root.querySelector('[data-posts]').textContent);
    const posts = data.posts;
    const dlg = root.querySelector('dialog');
    const q = (s) => dlg.querySelector(s);
    const media = q('[data-media]');
    const img = q('[data-img]');
    const cap = q('[data-caption]');
    const cnt = q('[data-count]');
    const dat = q('[data-date]');
    const lnk = q('[data-link]');
    const thumbs = q('[data-thumbs]');
    const prev = q('[data-prev]');
    const next = q('[data-next]');
    const prevPost = q('[data-prev-post]');
    const nextPost = q('[data-next-post]');
    let p = 0, k = 0, opener = null;

    // Le texte de la publication : retours à la ligne gardés, mots-dièse,
    // mentions et adresses transformés en liens. Construit par le DOM, jamais
    // par innerHTML : la légende vient d'Instagram, on ne l'interprète pas.
    const TOKEN = /(https?:\/\/[^\s]+|[#@][\p{L}\p{N}_.]+)/gu;
    function renderCaption(text) {
      cap.textContent = '';
      const parts = text.split(TOKEN);
      parts.forEach((part) => {
        if (!part) return;
        if (/^https?:\/\//.test(part)) {
          const a = document.createElement('a');
          a.href = part; a.textContent = part; a.target = '_blank'; a.rel = 'noopener';
          cap.appendChild(a);
        } else if (part[0] === '#' || part[0] === '@') {
          const a = document.createElement('a');
          const word = part.slice(1).replace(/\.$/, '');
          a.href = part[0] === '#'
            ? 'https://www.instagram.com/explore/tags/' + encodeURIComponent(word) + '/'
            : 'https://www.instagram.com/' + encodeURIComponent(word) + '/';
          a.className = 'ses-lb__tag'; a.textContent = part; a.target = '_blank'; a.rel = 'noopener';
          cap.appendChild(a);
        } else {
          cap.appendChild(document.createTextNode(part));
        }
      });
    }

    function buildThumbs(post) {
      thumbs.textContent = '';
      thumbs.hidden = post.images.length < 2;
      post.images.forEach((im, i) => {
        const b = document.createElement('button');
        b.type = 'button'; b.role = 'tab';
        b.setAttribute('aria-label', data.t.photo + ' ' + (i + 1) + ' ' + data.t.of + ' ' + post.images.length);
        const t = document.createElement('img');
        t.src = im.thumb; t.alt = ''; t.loading = 'lazy'; t.width = 56; t.height = 56;
        b.appendChild(t);
        b.addEventListener('click', () => { k = i; showImage(); });
        thumbs.appendChild(b);
      });
    }

    function showImage() {
      const post = posts[p];
      const im = post.images[k];
      img.classList.add('is-loading');
      const done = () => img.classList.remove('is-loading');
      img.onload = done; img.onerror = done;
      img.src = im.src;
      if (im.w && im.h) { img.width = im.w; img.height = im.h; }
      const multi = post.images.length > 1;
      cnt.textContent = multi ? (k + 1) + ' / ' + post.images.length : '';
      cnt.hidden = !multi;
      Array.from(thumbs.children).forEach((b, i) => {
        b.setAttribute('aria-selected', i === k ? 'true' : 'false');
        if (i === k) b.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
      });
      // Précharge la photo suivante pour un défilement sans à-coup.
      const after = post.images[k + 1] || (posts[p + 1] && posts[p + 1].images[0]);
      if (after) { const pre = new Image(); pre.src = after.src; }
    }

    function showPost() {
      const post = posts[p];
      renderCaption(post.caption);
      dat.textContent = post.date;
      lnk.href = post.permalink;
      buildThumbs(post);
      prevPost.disabled = p === 0;
      nextPost.disabled = p === posts.length - 1;
      media.scrollTop = 0;
      q('.ses-lb__body').scrollTop = 0;
      showImage();
    }

    function open(i, from) {
      p = i; k = 0; opener = from;
      showPost();
      dlg.showModal();
      q('[data-box]').focus({ preventScroll: true });
    }

    // Avance ou recule d'une photo ; au bout d'un album, passe à la
    // publication voisine.
    function step(d) {
      const n = posts[p].images.length;
      if (k + d >= 0 && k + d < n) { k += d; showImage(); return; }
      if (d > 0 && p < posts.length - 1) { p += 1; k = 0; showPost(); }
      else if (d < 0 && p > 0) { p -= 1; k = posts[p].images.length - 1; showPost(); }
    }
    function jump(d) {
      const n = p + d;
      if (n < 0 || n >= posts.length) return;
      p = n; k = 0; showPost();
    }

    root.querySelectorAll('[data-post]').forEach((a) => {
      a.addEventListener('click', (e) => { e.preventDefault(); open(Number(a.dataset.post), a); });
    });
    prev.addEventListener('click', () => step(-1));
    next.addEventListener('click', () => step(1));
    prevPost.addEventListener('click', () => jump(-1));
    nextPost.addEventListener('click', () => jump(1));
    q('[data-close]').addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('close', () => { img.removeAttribute('src'); if (opener) opener.focus(); });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); step(-1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); step(1); }
    });
    // Balayage au doigt sur la photo.
    let x0 = null, y0 = null;
    media.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }, { passive: true });
    media.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0;
      x0 = y0 = null;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) step(dx < 0 ? 1 : -1);
    });
  })();
</script>

<style>
  /* ── La grille ─────────────────────────────────────────────────── */
  .ses-insta__grid {
    display: grid;
    gap: 0.6rem;
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 40rem) { .ses-insta__grid { grid-template-columns: repeat(4, 1fr); gap: 0.85rem; } }
  .ses-insta__tile {
    position: relative;
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius-2);
    background: var(--ses-page-alt);
  }
  .ses-insta__tile img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 600ms ease; }
  .ses-insta__tile:hover img { transform: scale(1.05); }
  .ses-insta__tile::after {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgb(28 39 51 / 0.35), transparent 50%);
    opacity: 0;
    transition: opacity var(--ease);
  }
  .ses-insta__tile:hover::after { opacity: 1; }
  .ses-insta__badge {
    position: absolute; top: 0.6rem; right: 0.6rem;
    display: inline-flex; align-items: center; gap: 0.3rem;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    background: rgb(28 39 51 / 0.65);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    backdrop-filter: blur(4px);
  }

  /* ── La visionneuse ────────────────────────────────────────────── */
  :global(body:has(.ses-lb[open])) { overflow: hidden; }

  .ses-lb {
    border: 0;
    padding: 0;
    margin: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    max-width: none;
    max-height: none;
    background: transparent;
    color: var(--ses-fg);
    display: none;
    place-items: center;
  }
  .ses-lb[open] { display: grid; }
  .ses-lb::backdrop { background: rgb(12 18 26 / 0.9); backdrop-filter: blur(8px); }
  @keyframes ses-lb-in { from { opacity: 0; transform: translateY(10px) scale(0.985); } to { opacity: 1; transform: none; } }

  .ses-lb__box {
    position: relative;
    outline: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 26rem;
    width: min(100vw - 2rem, 1180px);
    height: min(100vh - 2rem, 820px);
    height: min(100dvh - 2rem, 820px);
    background: var(--ses-surface);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 40px 90px rgb(0 0 0 / 0.5);
    animation: ses-lb-in 260ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  @media (prefers-reduced-motion: reduce) { .ses-lb__box { animation: none; } }

  .ses-lb__close {
    position: absolute; top: 0.75rem; right: 0.75rem; z-index: 3;
    display: inline-flex; align-items: center; justify-content: center;
    width: 2.5rem; height: 2.5rem;
    border-radius: 999px;
    border: 1px solid var(--ses-border);
    background: var(--ses-surface);
    color: var(--ses-fg);
    cursor: pointer;
    transition: background-color var(--ease), color var(--ease);
  }
  .ses-lb__close:hover { background: var(--ses-nuit); color: #fff; border-color: var(--ses-nuit); }

  /* Le volet photo */
  .ses-lb__media {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0; min-height: 0;
    background: #0f151c;
    overflow: hidden;
  }
  /* La photo occupe tout le volet et se centre d'elle-même (object-fit). */
  .ses-lb__img {
    display: block;
    flex: 1 1 auto;
    min-height: 0;
    width: 100%; height: 100%;
    object-fit: contain;
    transition: opacity 220ms ease;
  }
  .ses-lb__img.is-loading { opacity: 0; }
  .ses-lb__count {
    position: absolute; top: 0.85rem; left: 0.85rem; margin: 0;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: rgb(28 39 51 / 0.7);
    color: #fff;
    font-size: 0.8rem; font-weight: 700; letter-spacing: 0.02em;
    backdrop-filter: blur(4px);
  }
  .ses-lb__arrow {
    position: absolute; top: 50%; transform: translateY(-50%);
    display: inline-flex; align-items: center; justify-content: center;
    width: 2.75rem; height: 2.75rem;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.25);
    background: rgb(28 39 51 / 0.55);
    color: #fff;
    cursor: pointer;
    backdrop-filter: blur(4px);
    opacity: 0.85;
    transition: background-color var(--ease), opacity var(--ease);
  }
  .ses-lb__arrow:hover { background: rgb(190 0 51 / 0.9); opacity: 1; border-color: transparent; }
  .ses-lb__arrow--prev { left: 0.85rem; }
  .ses-lb__arrow--next { right: 0.85rem; }
  .ses-lb__thumbs {
    display: flex; gap: 0.4rem;
    flex: 0 0 auto;
    justify-content: safe center;
    padding: 0.6rem 0.85rem;
    overflow-x: auto;
    scrollbar-width: none;
    background: #0a0f14;
  }
  .ses-lb__thumbs::-webkit-scrollbar { display: none; }
  .ses-lb__thumbs[hidden] { display: none; }
  /* Les vignettes et les liens de la légende sont créés par le script : :global() pour que les styles les atteignent. */
  .ses-lb__thumbs :global(button) {
    flex: 0 0 auto;
    width: 3.5rem; height: 3.5rem;
    padding: 0; border: 2px solid transparent;
    border-radius: 8px;
    overflow: hidden;
    background: #000;
    cursor: pointer;
    opacity: 0.55;
    transition: opacity var(--ease), border-color var(--ease);
  }
  .ses-lb__thumbs :global(button img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ses-lb__thumbs :global(button:hover) { opacity: 0.9; }
  .ses-lb__thumbs :global(button[aria-selected='true']) { opacity: 1; border-color: var(--ses-gold); }

  /* Le volet texte */
  .ses-lb__side {
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: 0;
    border-left: 1px solid var(--ses-border);
  }
  .ses-lb__head {
    display: flex; align-items: center; gap: 0.75rem;
    padding: 1rem 3.5rem 1rem 1.25rem;
    border-bottom: 1px solid var(--ses-border);
  }
  .ses-lb__avatar {
    flex: 0 0 auto;
    display: grid; place-items: center;
    width: 2.75rem; height: 2.75rem;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 0 0 2px #fff, 0 0 0 4px var(--ses-red);
  }
  .ses-lb__avatar img { width: 1.75rem; height: 1.75rem; }
  .ses-lb__who { display: grid; line-height: 1.25; min-width: 0; }
  .ses-lb__who strong { font-family: var(--ses-font-heading); font-size: 0.95rem; color: var(--ses-nuit); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ses-lb__who a { font-size: var(--text-small); color: var(--ses-muted); text-decoration: none; }
  .ses-lb__who a:hover { color: var(--ses-red-deep); text-decoration: underline; }
  .ses-lb__ig { display: none; }
  .ses-lb__body { min-height: 0; overflow-y: auto; padding: 1.25rem; overscroll-behavior: contain; }
  .ses-lb__caption {
    margin: 0;
    white-space: pre-line;
    font-size: 1rem;
    line-height: 1.6;
    text-align: left;
    overflow-wrap: anywhere;
  }
  .ses-lb__caption :global(a) { color: var(--ses-red-deep); text-decoration: none; }
