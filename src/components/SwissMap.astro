---
/**
 * La carte compacte des implantations (page d'accueil, rubrique « Nous
 * rejoindre ») : le fond de carte et les repères, chaque repère menant à sa
 * fiche sur la page des implantations. L'explorateur complet est
 * `ImplantationsExplorer.astro`.
 */
import SwissMapSvg from './SwissMapSvg.astro';
import { getPlaces } from '../lib/implantations';
import type { Lang } from '../data/site';

interface Props {
  lang: Lang;
  /** Adresse de la page des implantations. */
  moreHref?: string | null;
}
const { lang, moreHref } = Astro.props;
const places = getPlaces();
const title = lang === 'fr' ? 'Carte des implantations du Scoutisme Européen Suisse' : 'Karte der Standorte der Schweizerischen Pfadfinderschaft Europas';
---

<figure class="ses-map-card">
  <SwissMapSvg places={places} title={title} href={(p) => (moreHref ? `${moreHref}#${p.id}` : `#${p.id}`)} />
</figure>

<style>
  .ses-map-card {
    margin: 0;
    background: var(--ses-surface);
    border: 1px solid var(--ses-border);
    border-radius: var(--radius-3);
    padding: var(--space-2);
    box-shadow: var(--shadow-1);
  }
</style>
